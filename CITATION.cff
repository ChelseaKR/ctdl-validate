    family-names: Kelly-Reif
license: Apache-2.0
repository-code: "https://github.com/ChelseaKR/ctdl-validate"
url: "https://github.com/ChelseaKR/ctdl-validate"
keywords:
  - ctdl
  - credential-engine
  - json-ld
  - validation
  - credentials
